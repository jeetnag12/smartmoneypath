# CRITICAL: Set this to your actual production domain (e.g., https://www.smartmoneypath.com)
# AdSense will reject your site if canonical URLs don't match your domain.
NEXT_PUBLIC_SITE_URL=https://www.yourdomain.com

# AdSense and site contact information
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.com
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-5428516361954387

# Create two responsive display ad units in AdSense and copy their numeric slot IDs.
NEXT_PUBLIC_ADSENSE_ARTICLE_TOP_SLOT=
NEXT_PUBLIC_ADSENSE_ARTICLE_BOTTOM_SLOT=
