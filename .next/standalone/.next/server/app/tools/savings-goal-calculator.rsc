bg-primary-100 flex items-center justify-center","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-piggy-bank h-5 w-5 text-primary-700","children":[["$","path","1ivx2i",{"d":"M19 5c-1.5 0-2.8 1.4-3 2-3.5-1.5-11-.3-11 5 0 1.8 0 3 2 4.5V20h4v-2h3v2h4v-4c1-.5 1.7-1 2-2h2v-4h-2c0-1-.5-1.5-1-2V5z"}],["$","path","nm575m",{"d":"M2 9v1c0 1.1.9 2 2 2h1"}],["$","path","xkw8gn",{"d":"M16 11h.01"}],"$undefined"]}]}],["$","span",null,{"className":"text-xs font-bold text-primary-800 bg-primary-100/50 px-3 py-1 rounded-full uppercase tracking-wider","children":"Saving Tools"}]]}],["$","h1",null,{"className":"text-3xl md:text-5xl font-black text-secondary-900 tracking-tight mb-4","children":"Savings Goal Calculator"}],["$","p",null,{"className":"text-lg text-secondary-655 max-w-3xl leading-relaxed","children":"Specify a target goal, list your starting balance and monthly additions, and discover exactly how many months it will take to hit your savings milestone."}]]}]}],["$","section",null,{"className":"py-16","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":["$","$L5",null,{}]}]}],["$","section",null,{"className":"py-20 bg-secondary-50 border-y border-secondary-200","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-3xl font-black text-secondary-900 mb-8 tracking-tight","children":"How Your Savings Timeline is Calculated"}],["$","div",null,{"className":"prose prose-secondary max-w-none space-y-8 text-secondary-700 leading-relaxed","children":[["$","p",null,{"children":"To determine how long it takes to reach a target savings amount, we solve the standard compounding interest future value equation for the number of months."}],["$","h3",null,{"className":"text-xl font-bold text-secondary-900 mt-8","children":"The Timeline Formula"}],["$","p",null,{"children":["If your account earns interest compounding monthly, the time required ",["$","strong",null,{"children":"n"}]," (in months) is solved using natural logarithms:"]}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-secondary-200 text-center font-mono text-lg text-secondary-900 my-4","children":"n = ln[ (A + PMT / r) / (P + PMT / r) ] / ln(1 + r)"}],["$","p",null,{"className":"text-sm text-secondary-550 pl-4 border-l-2 border-primary-500","children":["Where:",["$","br",null,{}],["$","strong",null,{"children":"A"}]," = target savings goal amount",["$","br",null,{}],["$","strong",null,{"children":"P"}]," = starting balance (current savings)",["$","br",null,{}],["$","strong",null,{"children":"PMT"}]," = monthly deposit amount",["$","br",null,{}],["$","strong",null,{"children":"r"}]," = monthly interest rate (annual interest rate / 12 / 100)",["$","br",null,{}],["$","strong",null,{"children":"ln"}]," = natural logarithm"]}],["$","p",null,{"children":"If the interest rate is 0%, the equation simplifies to a basic linear relationship:"}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-secondary-200 text-center font-mono text-lg text-secondary-900 my-4","children":"n = (A - P) / PMT"}],["$","div",null,{"className":"h-px bg-secondary-200 my-8"}],["$","h3",null,{"className":"text-2xl font-black text-secondary-900 mb-4 tracking-tight","children":"Worked Example"}],["$","p",null,{"children":"Let's walk through an example. Suppose you set the following goals:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Target Goal (A)"}],": $20,000"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Starting Balance (P)"}],": $5,000"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Monthly Deposit (PMT)"}],": $500"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Annual APY"}],": 4.5%"]}]]}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 1: Calculate the monthly interest rate (r)"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":"r = 4.5% / 12 / 100 = 0.00375 (monthly rate as decimal)"}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 2: Calculate PMT / r"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":"PMT / r = 500 / 0.00375 = $133,333.33"}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 3: Solve for n (Months Required)"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":["n = ln[ (20,000 + 133,333.33) / (5,000 + 133,333.33) ] / ln(1 + 0.00375)",["$","br",null,{}],"n = ln[ 153,333.33 / 138,333.33 ] / ln(1.00375)",["$","br",null,{}],"n = ln(1.108434) / ln(1.00375)",["$","br",null,{}],"n = 0.102948 / 0.003743 = 27.5 Months"]}],["$","p",null,{"children":["By rounding up, it will take you approximately ",["$","strong",null,{"children":"28 months"}]," (about 2 years and 4 months) to save $20,000. During this period, you will have deposited ",["$","strong",null,{"children":"$$14,000"}]," on top of your initial $5,000, and earned ",["$","strong",null,{"children":"$$1,000"}]," in compound interest."]}]]}]]}]}],["$","section",null,{"className":"py-20 bg-white","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-3xl font-black text-secondary-900 mb-12 tracking-tight text-center","children":"Frequently Asked Questions (FAQ)"}],["$","div",null,{"className":"space-y-8","children":[["$","div","0",{"className":"p-8 bg-secondary-50 border border-secondary-150 rounded-3xl","children":[["$","h3",null,{"className":"text-lg font-bold text-secondary-955 mb-3","children":"How doe