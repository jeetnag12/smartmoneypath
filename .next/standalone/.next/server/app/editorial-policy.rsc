"/contact","className":"hover:text-primary-600 underline underline-offset-4","children":"Contact Editorial Team"}]]}],["$","p",null,{"className":"italic","children":"Disclaimer: The information provided on SmartMoneyPath is for educational purposes only. We do not provide individualized financial, legal, or tax advice. Past performance of any financial product is not a guarantee of future results."}]]}]]}]}]}],["$","footer",null,{"className":"bg-darkGreen text-white/80","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12","children":[["$","div",null,{"className":"flex flex-col lg:flex-row justify-between gap-8 pb-8 border-b border-white/10","children":[["$","div",null,{"className":"max-w-md","children":[["$","$L4",null,{"href":"/","className":"flex items-center gap-2 mb-4","children":[["$","span",null,{"className":"bg-brightGreen p-2 rounded-lg","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-wallet h-5 w-5 text-white","children":[["$","path","18etb6",{"d":"M19 7V4a1 1 0 0 0-1-1H5a2 2 0 0 0 0 4h15a1 1 0 0 1 1 1v4h-3a2 2 0 0 0 0 4h3a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1"}],["$","path","xoc0q4",{"d":"M3 5v14a2 2 0 0 0 2 2h15a1 1 0 0 0 1-1v-4"}],"$undefined"]}]}],["$","span",null,{"className":"text-xl font-bold text-white","children":"SmartMoneyPath"}]]}],["$","p",null,{"className":"text-sm leading-relaxed","children":"Independent educational articles based on public primary sources. We do not sell financial products or provide individualized advice."}],["$","a",null,{"className":"inline-block mt-3 text-sm text-white hover:underline","href":"mailto:hello@smartmoneypath.com","children":"hello@smartmoneypath.com"}]]}],["$","nav",null,{"aria-label":"Footer navigation","className":"grid grid-cols-2 sm:grid-cols-4 gap-x-8 gap-y-3","children":[["$","$L4","/art