ull,{"className":"w-10 h-10 rounded-xl bg-primary-100 flex items-center justify-center","children":["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-percent h-5 w-5 text-primary-700","children":[["$","line","1x9vlm",{"x1":"19","x2":"5","y1":"5","y2":"19"}],["$","circle","4mh3h7",{"cx":"6.5","cy":"6.5","r":"2.5"}],["$","circle","1mdrzq",{"cx":"17.5","cy":"17.5","r":"2.5"}],"$undefined"]}]}],["$","span",null,{"className":"text-xs font-bold text-primary-800 bg-primary-100/50 px-3 py-1 rounded-full uppercase tracking-wider","children":"Investment Tools"}]]}],["$","h1",null,{"className":"text-3xl md:text-5xl font-black text-secondary-900 tracking-tight mb-4","children":"Compound Interest Calculator"}],["$","p",null,{"className":"text-lg text-secondary-655 max-w-3xl leading-relaxed","children":"Project your portfolio value over time using various interest compounding frequencies (monthly, quarterly, semi-annually, annually) and regular monthly deposits."}]]}]}],["$","section",null,{"className":"py-16","children":["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8","children":["$","$L5",null,{}]}]}],["$","section",null,{"className":"py-20 bg-secondary-50 border-y border-secondary-200","children":["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8","children":[["$","h2",null,{"className":"text-3xl font-black text-secondary-900 mb-8 tracking-tight","children":"How Compound Interest is Calculated"}],["$","div",null,{"className":"prose prose-secondary max-w-none space-y-8 text-secondary-700 leading-relaxed","children":[["$","p",null,{"children":["Compound interest occurs when interest is added to the principal of an investment, so that from that moment on, the interest that has been added also earns interest. This addition of interest is known as ",["$","strong",null,{"children":"compounding"}],"."]}],["$","h3",null,{"className":"text-xl font-bold text-secondary-900 mt-8","children":"The Compounding Formula"}],["$","p",null,{"children":"The basic formula for compounding interest over a set period is:"}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-secondary-200 text-center font-mono text-lg text-secondary-900 my-4","children":"A = P (1 + r / n)^(nt)"}],["$","p",null,{"className":"text-sm text-secondary-550 pl-4 border-l-2 border-primary-500","children":["Where:",["$","br",null,{}],["$","strong",null,{"children":"A"}]," = the future value of the investment, including interest",["$","br",null,{}],["$","strong",null,{"children":"P"}]," = the initial principal investment amount",["$","br",null,{}],["$","strong",null,{"children":"r"}]," = the annual interest rate (decimal)",["$","br",null,{}],["$","strong",null,{"children":"n"}]," = the compounding frequency per year (e.g. 12 for monthly)",["$","br",null,{}],["$","strong",null,{"children":"t"}]," = the number of years the money is invested for"]}],["$","h3",null,{"className":"text-xl font-bold text-secondary-900 mt-8","children":"Adding Regular Contributions"}],["$","p",null,{"children":"When you add monthly contributions (deposits), we also calculate the future value of an ordinary annuity (the regular monthly additions):"}],["$","div",null,{"className":"bg-white p-6 rounded-2xl border border-secondary-200 text-center font-mono text-lg text-secondary-900 my-4","children":"A_annuity = PMT * [((1 + r / n)^(nt) - 1) / (r / n)]"}],["$","p",null,{"children":"This formula assumes contributions are added at the end of each period. Our calculator adds deposits monthly and computes interest dynamically according to your chosen frequency, mirroring real-world bank and brokerage practices."}],["$","div",null,{"className":"h-px bg-secondary-200 my-8"}],["$","h3",null,{"className":"text-2xl font-black text-secondary-900 mb-4 tracking-tight","children":"Worked Example"}],["$","p",null,{"children":"Let's walk through a concrete example. Suppose you start with:"}],["$","ul",null,{"className":"list-disc pl-6 space-y-2","children":[["$","li",null,{"children":[["$","strong",null,{"children":"Initial Principal (P)"}],": $10,000"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Monthly Addition (PMT)"}],": $200"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Annual Interest Rate (r)"}],": 8% (0.08)"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Growth Duration (t)"}],": 5 Years"]}],["$","li",null,{"children":[["$","strong",null,{"children":"Compounding Frequency (n)"}],": Monthly (12 times a year)"]}]]}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 1: Future Value of the Initial $10,000"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":["A_initial = 10,000 * (1 + 0.08 / 12)^(12 * 5)",["$","br",null,{}],"A_initial = 10,000 * (1.006667)^60",["$","br",null,{}],"A_initial = $14,898.46"]}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 2: Future Value of the $200 Monthly Additions"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":["A_annuity = 200 * [((1 + 0.08 / 12)^60 - 1) / (0.08 / 12)]",["$","br",null,{}],"A_annuity = 200 * [(1.489846 - 1) / 0.006667]",["$","br",null,{}],"A_annuity = 200 * 73.476856",["$","br",null,{}],"A_annuity = $14,695.37"]}],["$","p",null,{"className":"font-bold text-secondary-900 mt-6","children":"Step 3: Total Portfolio Future Value"}],["$","p",null,{"className":"font-mono bg-white p-4 rounded-xl border border-secondary-100 text-sm","children":["Total Future Value = A_initial + A_annuity",["$","br",null,{}],"Total Future Value = 14,898.46 + 14,695.37 = $29,593.83"]}],["$","p",null,{"children":["In this scenario, you deposited a total of ",["$","strong",null,{"children":"$$22,000"}]